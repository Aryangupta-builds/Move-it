<UserControl x:Class="MoveIt.Radar"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" Width="300" Height="300">
    <Ellipse Width="290" Height="290" StrokeThickness="1.2" Stroke="#40FFFFFF" Fill="#0A2F80ED"/>
    <Ellipse Width="205" Height="205" StrokeThickness="1" Stroke="#33FFFFFF"/>
    <Ellipse Width="125" Height="125" StrokeThickness="1" Stroke="#33FFFFFF" Fill="#0F56CCF2"/>
    <Canvas x:Name="Sweep" Width="300" Height="300" RenderTransformOrigin="0.5,0.5">
      <Canvas.RenderTransform><RotateTransform x:Name="SweepRot"/></Canvas.RenderTransform>
      <Path Data="M150,150 L150,5 A145,145 0 0 1 275.6,77.5 Z">
        <Path.Fill>
          <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#0056CCF2" Offset="0"/><GradientStop Color="#992F9BFF" Offset="1"/>
          </LinearGradientBrush>
        </Path.Fill>
      </Path>
    </Canvas>
    <Grid Width="84" Height="84">
      <Ellipse><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF2F80ED" Offset="0"/><GradientStop Color="#FF56CCF2" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse>
      <FontIcon Glyph="&#xE7F8;" FontSize="40" Foreground="White"/>
    </Grid>
    <TextBlock x:Name="NameText" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,118,0,0" TextTrimming="CharacterEllipsis" MaxWidth="110" TextAlignment="Center"/>
    <Grid x:Name="Check" Width="96" Height="96" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform><CompositeTransform x:Name="CheckT" ScaleX="0" ScaleY="0"/></Grid.RenderTransform>
      <Ellipse Fill="#FF22C55E"/>
      <FontIcon Glyph="&#xE73E;" FontSize="46" Foreground="White"/>
    </Grid>
  </Grid>
</UserControl>
