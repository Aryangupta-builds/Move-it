<Window x:Class="MoveIt.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:MoveIt">
  <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden" Background="{ThemeResource BgBrush}" PointerPressed="Root_PointerPressed" SizeChanged="Root_SizeChanged">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="Escape" Invoked="Back_Accel"/>
      <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="Back_Accel"/>
    </Grid.KeyboardAccelerators>
    <!-- Narrow/wide layout is applied in code (ApplyLayout in MainWindow.xaml.cs) -->

    <!-- soft aurora background (Composition, see AuroraBg.xaml.cs) -->
    <local:AuroraBg x:Name="Aurora"/>

    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <!-- HEADER: logo + name + version, always on top -->
      <Grid x:Name="HeaderBar" Grid.Row="0" Padding="12,0,150,0" Canvas.ZIndex="10" Height="48">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button x:Name="BackBtn" Click="Back_Click" Visibility="Collapsed" Style="{StaticResource MiButton}" MinHeight="34" Padding="12,4" ToolTipService.ToolTip="Back (Esc)">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="14"/><TextBlock Text="Back"/></StackPanel>
          </Button>
          <Image Source="ms-appx:///Assets/logo.png" Width="26" Height="26"/>
          <TextBlock Text="MoveIt" Style="{StaticResource MiSubhead}" VerticalAlignment="Center"/>
          <Border CornerRadius="8" Padding="7,1" Background="{ThemeResource GlassBrush}" VerticalAlignment="Center"><TextBlock x:Name="VersionText" FontSize="11" Opacity="0.8"/></Border>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button x:Name="HistoryBtn" Click="OpenHistory_Click" Width="40" Height="36" Padding="0" CornerRadius="18" ToolTipService.ToolTip="Transfer history">
            <FontIcon Glyph="&#xE81C;" FontSize="16"/>
          </Button>
          <Button x:Name="SettingsBtn" Click="OpenSettings_Click" Width="40" Height="36" Padding="0" CornerRadius="18" ToolTipService.ToolTip="Settings">
            <FontIcon Glyph="&#xE713;" FontSize="16"/>
          </Button>
        </StackPanel>
      </Grid>

      <Grid x:Name="PagesHost" Grid.Row="1" Padding="24,0">
        <!-- SETUP / ONBOARDING (first run) -->
        <Grid x:Name="SetupPage" Visibility="Collapsed">
          <Grid.OpacityTransition><ScalarTransition/></Grid.OpacityTransition>
          <Grid MaxWidth="580" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer>
              <Grid VerticalAlignment="Center" Margin="0,0,0,12">
                <StackPanel x:Name="Step0" Spacing="12">
                  <Border Width="96" Height="96" CornerRadius="26" HorizontalAlignment="Center"><Border.Shadow><ThemeShadow/></Border.Shadow><Image Source="ms-appx:///Assets/logo.png"/></Border>
                  <TextBlock Text="Welcome to MoveIt" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                  <TextBlock Text="Move everything to your new laptop over your own WiFi. No cables, no cloud, no account." Opacity="0.75" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                  <StackPanel x:Name="S0Host" Spacing="10" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel x:Name="Step1" Spacing="12" Visibility="Collapsed">
                  <TextBlock Text="How it works" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center"/>
                  <TextBlock Text="Three simple steps, one on each laptop." Opacity="0.75" HorizontalAlignment="Center"/>
                  <StackPanel x:Name="S1Host" Spacing="10" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel x:Name="Step2" Spacing="12" Visibility="Collapsed">
                  <TextBlock Text="What you can send" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center"/>
                  <TextBlock Text="Pick a mode on the Send screen." Opacity="0.75" HorizontalAlignment="Center"/>
                  <StackPanel x:Name="S2Host" Spacing="10" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel x:Name="Step3" Spacing="12" Visibility="Collapsed">
                  <TextBlock Text="Allow network access" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center"/>
                  <Border Style="{StaticResource GlassCard}">
                    <StackPanel Spacing="12">
                      <TextBlock TextWrapping="Wrap" Opacity="0.85" Text="Windows Firewall blocks other devices from reaching apps by default. MoveIt needs access on your private WiFi so the two laptops can find each other and your phone can connect. Everything stays on your local network and nothing goes to the internet."/>
                      <TextBlock TextWrapping="Wrap" Opacity="0.85" Text="Tap the button, then choose Yes on the Windows prompt. You only do this once."/>
                      <Button x:Name="FwBtn" Content="Allow network access" Style="{StaticResource AccentButtonStyle}" CornerRadius="12" HorizontalAlignment="Stretch" Height="44" Click="Firewall_Click"/>
                      <TextBlock x:Name="FwStatus" Opacity="0.85" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
                <StackPanel x:Name="Step4" Spacing="12" Visibility="Collapsed">
                  <TextBlock Text="Make it yours" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center"/>
                  <Border Style="{StaticResource GlassCard}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Laptop name" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                      <TextBlock Text="This is the name the other laptop will see." Opacity="0.7" FontSize="12"/>
                      <TextBox x:Name="SetupName"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource GlassCard}">
                    <StackPanel Spacing="4">
                      <ToggleSwitch x:Name="SetupMobile" IsOn="True" Header="Receive files from my phone or tablet"/>
                      <TextBlock Text="Shows a QR code on the Receive screen. You can change this later in Settings." Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Spacing="12">
              <StackPanel x:Name="Dots" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"/>
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="StepBack" Content="Back" CornerRadius="14" Height="44" MinWidth="90" Click="StepBack_Click"/>
                <HyperlinkButton x:Name="StepSkip" Grid.Column="1" Content="Skip intro" HorizontalAlignment="Center" Click="StepSkip_Click"/>
                <Button x:Name="StepNext" Grid.Column="2" Content="Next" Style="{StaticResource AccentButtonStyle}" CornerRadius="14" Height="44" MinWidth="130" Click="StepNext_Click"/>
              </Grid>
            </StackPanel>
          </Grid>
        </Grid>

        <!-- HOME -->
        <Grid x:Name="HomePage">
          <Grid.OpacityTransition><ScalarTransition/></Grid.OpacityTransition>
          <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640" Spacing="28" Margin="0,8,0,28">
              <StackPanel Spacing="4" HorizontalAlignment="Center">
                <Border Width="84" Height="84" CornerRadius="24" HorizontalAlignment="Center"><Border.Shadow><ThemeShadow/></Border.Shadow><Image Source="ms-appx:///Assets/logo.png"/></Border>
                <TextBlock Text="MoveIt" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="Move everything to your new laptop over WiFi" Style="{StaticResource MiBody}" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center"/>
                <Border CornerRadius="14" Padding="12,5" HorizontalAlignment="Center" Margin="0,12,0,0" Background="{ThemeResource GlassBrush}" BorderBrush="{ThemeResource GlassStroke}" BorderThickness="1">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource OkBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HomeInfo" FontSize="12" Opacity="0.85" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Spacing="14" Margin="12,0">
                <Button x:Name="SendCard" Style="{StaticResource CardButton}" Click="SendCard_Click" AutomationProperties.Name="Send files from this laptop">
                  <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource TileBlue}"><FontIcon Glyph="&#xE898;" FontSize="28" Foreground="White"/></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="Send" Style="{StaticResource MiHeading}"/>
                      <TextBlock Text="Send files, folders or your whole setup to another laptop" Style="{StaticResource MiCaption}"/>
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="16" Opacity="0.55" VerticalAlignment="Center"/>
                  </Grid>
                </Button>
                <Button x:Name="RxCard" Style="{StaticResource CardButton}" Click="RxCard_Click" AutomationProperties.Name="Receive files on this laptop">
                  <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource TileGreen}"><FontIcon Glyph="&#xE896;" FontSize="28" Foreground="White"/></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="Receive" Style="{StaticResource MiHeading}"/>
                      <TextBlock Text="Get files from another laptop, or from your phone or tablet" Style="{StaticResource MiCaption}"/>
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="16" Opacity="0.55" VerticalAlignment="Center"/>
                  </Grid>
                </Button>
              </StackPanel>

              <StackPanel Spacing="6" HorizontalAlignment="Center">
                <HyperlinkButton Click="OpenHistory_Click" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE81C;" FontSize="14"/><TextBlock Text="Transfer history"/></StackPanel></HyperlinkButton>
                <TextBlock Text="Private  •  No account  •  No cables" Style="{StaticResource MiCaption}" HorizontalAlignment="Center" TextAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- SCAN / device discovery: radar centred in the page; the "nothing found" help appears BELOW in a reserved area (nothing jumps) -->
        <Grid x:Name="ScanPage" Visibility="Collapsed">
          <Grid.OpacityTransition><ScalarTransition/></Grid.OpacityTransition>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto" MinHeight="190"/></Grid.RowDefinitions>
          <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Spacing="14" Margin="0,8,0,8">
              <Grid HorizontalAlignment="Center">
                <!-- soft glow behind the radar -->
                <Ellipse Width="330" Height="330" IsHitTestVisible="False">
                  <Ellipse.Fill>
                    <RadialGradientBrush>
                      <GradientStop Color="#3338BDF8" Offset="0"/><GradientStop Color="#1A8B5CF6" Offset="0.55"/><GradientStop Color="#008B5CF6" Offset="1"/>
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Viewbox MaxWidth="290" MaxHeight="290"><local:Radar x:Name="ScanRadar"/></Viewbox>
              </Grid>
              <TextBlock x:Name="ScanTitle" Text="Looking for nearby laptops…" Style="{StaticResource MiTitle}" FontSize="24" HorizontalAlignment="Center" TextAlignment="Center"/>
              <TextBlock Text="Open MoveIt on the other laptop and tap Receive, then choose Pairing code" Style="{StaticResource MiBody}" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center"/>
              <!-- loading state -->
              <Border x:Name="ScanLoading" CornerRadius="16" Padding="14,7" HorizontalAlignment="Center" Background="{ThemeResource GlassBrush}" BorderBrush="{ThemeResource GlassStroke}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <ProgressRing IsActive="True" Width="16" Height="16"/>
                  <TextBlock Text="Searching your WiFi…" Style="{StaticResource MiCaption}" Opacity="0.9" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
              <GridView x:Name="DeviceGrid" IsItemClickEnabled="True" SelectionMode="None" ItemClick="Device_Click" HorizontalAlignment="Center">
                <GridView.ItemTemplate>
                  <DataTemplate x:DataType="local:DeviceItem">
                    <Border Style="{StaticResource GlassCard}" Width="160" Padding="12">
                      <StackPanel Spacing="6">
                        <Grid Width="56" Height="56" HorizontalAlignment="Center">
                          <Ellipse><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF2F80ED" Offset="0"/><GradientStop Color="#FF56CCF2" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse>
                          <FontIcon Glyph="&#xE7F8;" FontSize="24" Foreground="White"/>
                        </Grid>
                        <TextBlock Text="{x:Bind Name}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind Ip}" HorizontalAlignment="Center" Opacity="0.6" FontSize="12"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </GridView.ItemTemplate>
              </GridView>
            </StackPanel>
          </ScrollViewer>

          <!-- below the radar: help (only after a few empty searches) + manual entry -->
          <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" MaxWidth="560" VerticalAlignment="Top" Margin="0,0,0,12">
            <Border x:Name="ScanEmpty" Style="{StaticResource GlassCard}" CornerRadius="20" Visibility="Collapsed" HorizontalAlignment="Stretch">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="14" VerticalAlignment="Top" Background="{StaticResource TileAmber}"><FontIcon Glyph="&#xE9CE;" FontSize="20" Foreground="White"/></Border>
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Text="No laptop found yet" Style="{StaticResource MiSubhead}"/>
                  <TextBlock Style="{StaticResource MiCaption}" Opacity="0.85" Text="•  Both laptops must be on the same WiFi network.&#x0A;•  The other laptop must be on the Receive screen.&#x0A;•  If Windows asked about network access, choose Allow.&#x0A;•  Still nothing? Use the pairing code and IP address."/>
                </StackPanel>
              </Grid>
            </Border>
            <HyperlinkButton Content="Can't find it? Enter pairing code or IP address" Click="Manual_Click" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <!-- SEND -->
        <Grid x:Name="SendPage" Visibility="Collapsed">
          <Grid.OpacityTransition><ScalarTransition/></Grid.OpacityTransition>
          <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="0,0,0,24">
              <TextBlock x:Name="SendTitle" Style="{StaticResource MiHeading}"/>
              <StackPanel x:Name="PickPanel" Spacing="14">
                <RadioButtons x:Name="ModeRadio" MaxColumns="3" SelectionChanged="Mode_Changed">
                  <x:String>Single file</x:String><x:String>Files and folders</x:String><x:String>Complete migration</x:String>
                </RadioButtons>
                <Border x:Name="FilesCard" Style="{StaticResource GlassCard}">
                  <StackPanel Spacing="10">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Files and folders" Style="{StaticResource MiSubhead}"/>
                      <TextBlock x:Name="SendSummary" Grid.Column="1" Style="{StaticResource MiCaption}"/>
                    </Grid>
                    <TextBlock x:Name="ItemsEmpty" Text="Nothing added yet. Add files or a folder to send." Style="{StaticResource MiCaption}"/>
                    <ListView x:Name="ItemList" MaxHeight="260" SelectionMode="None">
                      <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SendItem">
                          <Grid ColumnSpacing="12" Padding="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{x:Bind Detail}" Style="{StaticResource MiCaption}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2" Tag="{x:Bind FullPath}" Click="RemoveItem_Click" Padding="8,6" CornerRadius="10" ToolTipService.ToolTip="Remove" AutomationProperties.Name="Remove from list"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
                          </Grid>
                        </DataTemplate>
                      </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Add files" Click="AddFiles_Click" Style="{StaticResource MiButton}"/>
                      <Button x:Name="AddFolderBtn" Content="Add folder" Click="AddFolder_Click" Style="{StaticResource MiButton}"/>
                      <Button Content="Clear" Click="Clear_Click" Style="{StaticResource MiButton}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border x:Name="MigCard" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Complete migration" Style="{StaticResource MiSubhead}"/>
                    <TextBlock Text="Copies your user folders and your app list. On the new laptop you can reinstall all apps with one tap." Style="{StaticResource MiCaption}"/>
                    <HyperlinkButton Content="Select everything" Click="SelectAll_Click" Padding="0"/>
                    <Grid ColumnSpacing="12">
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                      <CheckBox x:Name="CbDesktop" Content="Desktop" MinWidth="0"/>
                      <CheckBox x:Name="CbDocuments" Content="Documents" Grid.Column="1" MinWidth="0"/>
                      <CheckBox x:Name="CbDownloads" Content="Downloads" Grid.Column="2" MinWidth="0"/>
                      <CheckBox x:Name="CbPictures" Content="Pictures" Grid.Row="1" MinWidth="0"/>
                      <CheckBox x:Name="CbVideos" Content="Videos" Grid.Row="1" Grid.Column="1" MinWidth="0"/>
                      <CheckBox x:Name="CbMusic" Content="Music" Grid.Row="1" Grid.Column="2" MinWidth="0"/>
                    </Grid>
                    <CheckBox x:Name="CbApps" Content="Installed apps list + auto-reinstall script (winget)"/>
                  </StackPanel>
                </Border>
                <Button x:Name="SendBtn" Content="Send" Style="{StaticResource MiPrimaryButton}" HorizontalAlignment="Stretch" Click="Send_Click"/>
              </StackPanel>

              <!-- sending / result -->
              <StackPanel x:Name="SendingPanel" Visibility="Collapsed" Spacing="12" HorizontalAlignment="Center" MaxWidth="620">
                <Viewbox MaxWidth="240" MaxHeight="240"><local:Radar x:Name="SendFx"/></Viewbox>
                <StackPanel x:Name="TxLive" Spacing="10">
                  <TextBlock x:Name="TxPercent" Text="0%" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <ProgressBar x:Name="TxBar" Maximum="100" CornerRadius="4"/>
                  <TextBlock x:Name="TxFile" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                  <TextBlock x:Name="TxStat" HorizontalAlignment="Center" TextAlignment="Center" Opacity="0.8" TextWrapping="Wrap"/>
                  <Button x:Name="CancelBtn" Content="Cancel transfer" HorizontalAlignment="Center" Style="{StaticResource MiButton}" Click="Cancel_Click">
                    <Button.Resources>
                      <SolidColorBrush x:Key="ButtonBackground" Color="#FFDC2626"/><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFB91C1C"/><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF991B1B"/>
                      <SolidColorBrush x:Key="ButtonForeground" Color="White"/><SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/><SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFDC2626"/><SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FFB91C1C"/><SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FF991B1B"/>
                    </Button.Resources>
                  </Button>
                </StackPanel>
                <Border x:Name="TxResult" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                  <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Grid Width="44" Height="44"><Ellipse x:Name="TxResDot" Fill="{StaticResource OkBrush}"/><FontIcon x:Name="TxResIcon" Glyph="&#xE73E;" FontSize="20" Foreground="White"/></Grid>
                      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="TxResTitle" Style="{StaticResource MiHeading}"/><TextBlock x:Name="TxResMsg" Style="{StaticResource MiCaption}"/></StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="TxResDetails" Style="{StaticResource MiBody}" IsTextSelectionEnabled="True"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button x:Name="TxAgainBtn" Content="Try again" Style="{StaticResource MiPrimaryButton}" Click="TxAgain_Click"/>
                      <Button x:Name="TxDeviceBtn" Content="Change device" Style="{StaticResource MiButton}" Click="TxChangeDevice_Click"/>
                      <Button x:Name="DoneBtn" Content="Back to home" Style="{StaticResource MiButton}" Click="Done_Click"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- RECEIVE: choose source -->
        <Grid x:Name="RxChoosePage" Visibility="Collapsed">
          <Grid.OpacityTransition><ScalarTransition/></Grid.OpacityTransition>
          <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640" Spacing="24" Margin="0,8,0,28">
              <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="How should the files reach you?" Style="{StaticResource MiTitle}" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="Pick the way that fits the device you are sending from" Style="{StaticResource MiBody}" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center"/>
              </StackPanel>
              <StackPanel Spacing="14" Margin="12,0">
                <Button x:Name="RxLapCard" Style="{StaticResource CardButton}" Click="RxFromLaptop_Click" AutomationProperties.Name="Receive with a pairing code from another laptop running MoveIt">
                  <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource TileBlue}"><FontIcon Glyph="&#xE7F8;" FontSize="28" Foreground="White"/></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="Pairing code" Style="{StaticResource MiHeading}"/>
                      <TextBlock Text="From another laptop that has MoveIt. Type a 6-digit code on it." Style="{StaticResource MiCaption}"/>
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="16" Opacity="0.55" VerticalAlignment="Center"/>
                  </Grid>
                </Button>
                <Button x:Name="RxPhoneCard" Style="{StaticResource CardButton}" Click="RxFromPhone_Click" AutomationProperties.Name="Receive with a QR code or link from a phone, tablet or any browser">
                  <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource TileAmber}"><FontIcon Glyph="&#xED14;" FontSize="28" Foreground="White"/></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="QR code or link" Style="{StaticResource MiHeading}"/>
                      <TextBlock Text="From a phone, tablet or any browser. No app needed." Style="{StaticResource MiCaption}"/>
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="16" Opacity="0.55" VerticalAlignment="Center"/>
                  </Grid>
                </Button>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- RECEIVE: 1) waiting view (only code or QR)  2) full-screen live view (particles + all transfer data) -->
        <Grid x:Name="RxPage" Visibility="Collapsed">
          <Grid.OpacityTransition><ScalarTransition/></Grid.OpacityTransition>

          <!-- 1) WAITING -->
          <ScrollViewer x:Name="RxWaitView" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Spacing="16" Margin="0,8,0,28">
              <StackPanel Spacing="4">
                <TextBlock x:Name="RxTitle" Text="Ready to receive" Style="{StaticResource MiTitle}" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock x:Name="RxName" Style="{StaticResource MiCaption}" HorizontalAlignment="Center" TextAlignment="Center"/>
              </StackPanel>
              <Border x:Name="CodeCard" Style="{StaticResource GlassCard}" CornerRadius="28" Padding="28,26">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                  <TextBlock Text="PAIRING CODE" Style="{StaticResource MiCaption}" CharacterSpacing="140" HorizontalAlignment="Center"/>
                  <Border CornerRadius="20" Padding="28,10" Background="#14FFFFFF" BorderBrush="{StaticResource QrRing}" BorderThickness="1.5" HorizontalAlignment="Center">
                    <TextBlock x:Name="CodeText" FontSize="46" FontWeight="Bold" FontFamily="Consolas" CharacterSpacing="320" HorizontalAlignment="Center" IsTextSelectionEnabled="True"/>
                  </Border>
                  <TextBlock Text="Enter this code on the sending laptop" Style="{StaticResource MiCaption}" HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
              </Border>
              <Border x:Name="PhoneCard" Style="{StaticResource GlassCard}" CornerRadius="30" Padding="30,30,30,24" Visibility="Collapsed">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                  <!-- QR tile: white card inside a thin gradient ring -->
                  <Border CornerRadius="30" Padding="3" Background="{StaticResource QrRing}" HorizontalAlignment="Center">
                    <Border Background="White" CornerRadius="27" Padding="18"><Image x:Name="QrImg" Width="220" Height="220"/></Border>
                  </Border>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Scan with a phone or tablet camera" Style="{StaticResource MiHeading}" FontSize="18" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="Both devices must be on the same WiFi. No app needed." Style="{StaticResource MiCaption}" HorizontalAlignment="Center" TextAlignment="Center"/>
                  </StackPanel>
                  <!-- no camera (e.g. another PC)? open the link in any browser -->
                  <Border CornerRadius="16" Padding="14,10" Background="#14FFFFFF" HorizontalAlignment="Center">
                    <StackPanel Spacing="6">
                      <TextBlock Text="OR OPEN THIS LINK IN ANY BROWSER" Style="{StaticResource MiCaption}" CharacterSpacing="100" HorizontalAlignment="Center"/>
                      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <TextBlock x:Name="RxLink" FontFamily="Consolas" FontSize="13" IsTextSelectionEnabled="True" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                        <Button Style="{StaticResource MiButton}" Padding="12,4" Click="CopyLink_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C8;" FontSize="12"/><TextBlock x:Name="CopyLinkText" Text="Copy link" FontSize="12"/></StackPanel></Button>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border CornerRadius="16" Padding="12,6" Background="#14FFFFFF" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="8" Height="8" Fill="{StaticResource WarnBrush}" VerticalAlignment="Center"/><TextBlock Text="Waiting for your phone" FontSize="12" Opacity="0.85"/></StackPanel>
                  </Border>
                </StackPanel>
              </Border>
              <TextBlock x:Name="RxStatus" Style="{StaticResource MiCaption}" HorizontalAlignment="Center" TextAlignment="Center"/>
              <TextBlock x:Name="RxNote" Visibility="Collapsed" Style="{StaticResource MiCaption}" Opacity="1" Foreground="{StaticResource WarnBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
          </ScrollViewer>

          <!-- 2) LIVE: full-screen particle effect, all data is shown on top of it -->
          <Border x:Name="RxLiveView" Visibility="Collapsed" RequestedTheme="Dark" CornerRadius="24" Margin="0,0,0,16" Background="{StaticResource StageBrush}" BorderBrush="#33FFFFFF" BorderThickness="1" SizeChanged="RxLive_SizeChanged">
            <Grid>
              <local:ParticleFlow x:Name="Particle"/>
              <Grid VerticalAlignment="Top" Margin="18,16,18,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border CornerRadius="14" Padding="12,6" Background="#26FFFFFF" HorizontalAlignment="Left"><TextBlock x:Name="RxDevice" Text="—" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></Border>
                <Border Grid.Column="1" CornerRadius="14" Padding="12,6" Background="#26FFFFFF"><TextBlock x:Name="RxStateText" Text="Waiting" FontSize="12" FontWeight="SemiBold"/></Border>
              </Grid>
              <Border x:Name="RxBottom" VerticalAlignment="Bottom" Margin="16" CornerRadius="18" Padding="18" Background="#D90A1330" BorderBrush="#26FFFFFF" BorderThickness="1" SizeChanged="RxBottom_SizeChanged"
                      Opacity="0" IsHitTestVisible="False" PointerEntered="RxBottom_PointerEntered" PointerExited="RxBottom_PointerExited">
                <Border.OpacityTransition><ScalarTransition Duration="0:0:0.35"/></Border.OpacityTransition>
                <StackPanel Spacing="12">
                  <StackPanel x:Name="RxResultHead" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                    <Grid Width="44" Height="44"><Ellipse x:Name="RxResDot" Fill="{StaticResource OkBrush}"/><FontIcon x:Name="RxResIcon" Glyph="&#xE73E;" FontSize="20" Foreground="White"/></Grid>
                    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="RxResTitle" Style="{StaticResource MiHeading}"/><TextBlock x:Name="RxResMsg" Style="{StaticResource MiCaption}"/></StackPanel>
                  </StackPanel>
                  <StackPanel x:Name="RxProgCard" Spacing="8" Visibility="Collapsed">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock x:Name="RxPercent" Text="0%" FontSize="32" FontWeight="SemiBold"/>
                      <TextBlock x:Name="RxStat" Grid.Column="1" Style="{StaticResource MiCaption}" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                    <ProgressBar x:Name="RxBar" Maximum="100" CornerRadius="4"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                      <TextBlock x:Name="RxSpeed" Text="—" FontWeight="SemiBold"/>
                      <TextBlock x:Name="RxEta" Text="ETA —" Opacity="0.8"/>
                    </StackPanel>
                  </StackPanel>
                  <Grid ColumnSpacing="16" RowSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.ColumnSpan="3"><TextBlock Text="File" Style="{StaticResource MiCaption}"/><TextBlock x:Name="RxFile" Text="—" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Row="1"><TextBlock Text="Format" Style="{StaticResource MiCaption}"/><TextBlock x:Name="RxFormat" Text="—"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Total size" Style="{StaticResource MiCaption}"/><TextBlock x:Name="RxSize" Text="—"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Files" Style="{StaticResource MiCaption}"/><TextBlock x:Name="RxFiles" Text="—"/></StackPanel>
                  </Grid>
                  <TextBlock x:Name="RxResDetails" Style="{StaticResource MiCaption}" Opacity="0.9" IsTextSelectionEnabled="True" Visibility="Collapsed"/>
                  <Button x:Name="RxCancelBtn" Content="Cancel transfer" HorizontalAlignment="Stretch" Visibility="Collapsed" Style="{StaticResource MiButton}" Click="RxCancel_Click">
                    <Button.Resources>
                      <SolidColorBrush x:Key="ButtonBackground" Color="#FFDC2626"/><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFB91C1C"/><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF991B1B"/>
                      <SolidColorBrush x:Key="ButtonForeground" Color="White"/><SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/><SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFDC2626"/><SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FFB91C1C"/><SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FF991B1B"/>
                    </Button.Resources>
                  </Button>
                  <StackPanel x:Name="RxResult" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <Button x:Name="RxAgainBtn" Content="Receive more" Style="{StaticResource MiPrimaryButton}" Click="RxAgain_Click"/>
                    <Button x:Name="RxOpenBtn" Content="Open folder" Style="{StaticResource MiButton}" Click="RxOpen_Click"/>
                    <Button x:Name="RxDoneBtn" Content="Done" Style="{StaticResource MiButton}" Click="RxDone_Click"/>
                  </StackPanel>
                  <Button x:Name="InstallBtn" Visibility="Collapsed" Content="Install all apps from old laptop" Style="{StaticResource MiButton}" HorizontalAlignment="Stretch" Click="InstallApps_Click"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <!-- HISTORY -->
        <Grid x:Name="HistoryPage" Visibility="Collapsed">
          <Grid.OpacityTransition><ScalarTransition/></Grid.OpacityTransition>
          <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="0,0,0,24">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Transfer history" Style="{StaticResource MiTitle}"/>
                <Button x:Name="HistClearBtn" Grid.Column="1" Content="Clear" Style="{StaticResource MiButton}" VerticalAlignment="Center" Click="HistClear_Click"/>
              </Grid>
              <Border x:Name="HistEmpty" Style="{StaticResource GlassCard}">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                  <FontIcon Glyph="&#xE81C;" FontSize="28" Opacity="0.6"/>
                  <TextBlock Text="No transfers yet" Style="{StaticResource MiSubhead}" HorizontalAlignment="Center"/>
                  <TextBlock Text="Completed, cancelled and failed transfers will show up here." Style="{StaticResource MiCaption}" TextAlignment="Center"/>
                </StackPanel>
              </Border>
              <ListView x:Name="HistList" SelectionMode="None">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="local:HistoryRow">
                    <Grid ColumnSpacing="14" Padding="0,6">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind Sub}" Style="{StaticResource MiCaption}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{x:Bind Status}" Foreground="{x:Bind StatusBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- SETTINGS -->
        <Grid x:Name="SettingsPage" Visibility="Collapsed">
          <Grid.OpacityTransition><ScalarTransition/></Grid.OpacityTransition>
          <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="0,0,0,24">
              <TextBlock Text="Settings" Style="{StaticResource MiTitle}"/>
              <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                  <TextBlock Text="Appearance" Style="{StaticResource MiSubhead}"/>
                  <RadioButtons x:Name="ThemeRadio" MaxColumns="3" SelectionChanged="Theme_Changed">
                    <x:String>System</x:String><x:String>Light</x:String><x:String>Dark</x:String>
                  </RadioButtons>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="14">
                  <TextBlock Text="General" Style="{StaticResource MiSubhead}"/>
                  <TextBox x:Name="NameBox" Header="Device name (shown to other devices)" LostFocus="Name_LostFocus"/>
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Default save folder" Style="{StaticResource MiCaption}"/>
                      <TextBlock x:Name="FolderText" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Change" Click="SettingsFolder_Click" Style="{StaticResource MiButton}"/>
                  </Grid>
                  <ToggleSwitch x:Name="OpenSwitch" Header="Open the folder when receiving finishes" Toggled="Open_Toggled"/>
                  <ToggleSwitch x:Name="MobileSwitch" Header="Receive files from phone / tablet (QR code)" Toggled="Mobile_Toggled"/>
                  <Button Content="Reset to defaults" Click="Reset_Click" Style="{StaticResource MiButton}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                  <TextBlock Text="About" Style="{StaticResource MiSubhead}"/>
                  <StackPanel Orientation="Horizontal" Spacing="14">
                    <Image Source="ms-appx:///Assets/logo.png" Width="52" Height="52"/>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="MoveIt" Style="{StaticResource MiHeading}"/><TextBlock x:Name="AboutVersion" Style="{StaticResource MiCaption}"/></StackPanel>
                  </StackPanel>
                  <TextBlock Text="Move files, folders and your app list between Windows laptops over WiFi. Nothing goes through the internet." Style="{StaticResource MiBody}" Opacity="0.8"/>
                  <TextBlock Text="What works: laptop to laptop (both directions) and phone / tablet to this laptop via QR code. Sending from this laptop to a phone is not supported: the phone only opens a web page and can only send." Style="{StaticResource MiCaption}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
