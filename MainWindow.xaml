<Window x:Class="MoveIt.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:MoveIt">
  <Grid x:Name="RootGrid" Background="{ThemeResource BgBrush}" PointerPressed="Root_PointerPressed">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="Escape" Invoked="Back_Accel"/>
      <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="Back_Accel"/>
    </Grid.KeyboardAccelerators>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="760"/></VisualState.StateTriggers></VisualState>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="RxCard.(Grid.Row)" Value="1"/>
            <Setter Target="RxCard.(Grid.Column)" Value="0"/>
            <Setter Target="PagesHost.Padding" Value="16,0"/>
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <!-- aurora background blobs, softened by the scrim below -->
    <Grid IsHitTestVisible="False">
      <Ellipse Width="560" Height="560" Fill="#FF1E6BFF" Opacity="0.55" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-160,0,0"><Ellipse.RenderTransform><CompositeTransform x:Name="B1"/></Ellipse.RenderTransform></Ellipse>
      <Ellipse Width="480" Height="480" Fill="#FF00D4FF" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-160,0"><Ellipse.RenderTransform><CompositeTransform x:Name="B2"/></Ellipse.RenderTransform></Ellipse>
      <Ellipse Width="520" Height="520" Fill="#FF7A4DFF" Opacity="0.45" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="120,0,0,-220"><Ellipse.RenderTransform><CompositeTransform x:Name="B3"/></Ellipse.RenderTransform></Ellipse>
    </Grid>
    <Border Background="{ThemeResource ScrimBrush}" IsHitTestVisible="False"/>

    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <!-- HEADER: always on top, never covered by page content -->
      <Grid Grid.Row="0" Padding="16,12" Canvas.ZIndex="10">
        <Button x:Name="BackBtn" Click="Back_Click" Visibility="Collapsed" HorizontalAlignment="Left" CornerRadius="14" Padding="14,8">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="14"/><TextBlock Text="Back"/></StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="26" Height="26" CornerRadius="7"><Image Source="ms-appx:///Assets/logo.png"/></Border>
          <TextBlock Text="MoveIt" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="SettingsBtn" Click="OpenSettings_Click" HorizontalAlignment="Right" CornerRadius="14" Padding="12,8">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE713;" FontSize="14"/><TextBlock Text="Settings"/></StackPanel>
        </Button>
      </Grid>

      <Grid x:Name="PagesHost" Grid.Row="1" Padding="40,0">
        <!-- HOME -->
        <Grid x:Name="HomePage">
          <Grid.OpacityTransition><ScalarTransition/></Grid.OpacityTransition>
          <ScrollViewer>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="28" Margin="0,10,0,30">
              <StackPanel Spacing="6" HorizontalAlignment="Center">
                <Border Width="110" Height="110" CornerRadius="28" HorizontalAlignment="Center"><Border.Shadow><ThemeShadow/></Border.Shadow><Image Source="ms-appx:///Assets/logo.png"/></Border>
                <TextBlock Text="MoveIt" Style="{StaticResource TitleLargeTextBlockStyle}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="Move everything to your new laptop over WiFi" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
              </StackPanel>
              <Grid ColumnSpacing="20" RowSpacing="20" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                <Border x:Name="SendCard" Height="200" Style="{StaticResource GlassCard}" CornerRadius="30" Tapped="SendCard_Tapped" PointerEntered="Card_Enter" PointerExited="Card_Exit">
                  <Border.ScaleTransition><Vector3Transition Duration="0:0:0.18"/></Border.ScaleTransition>
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                    <Grid Width="76" Height="76"><Ellipse><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF2F80ED" Offset="0"/><GradientStop Color="#FF56CCF2" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse><FontIcon Glyph="&#xE898;" FontSize="34" Foreground="White"/></Grid>
                    <TextBlock Text="Send" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="From this laptop" FontSize="13" Opacity="0.65" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <Border x:Name="RxCard" Grid.Column="1" Height="200" Style="{StaticResource GlassCard}" CornerRadius="30" Tapped="RxCard_Tapped" PointerEntered="Card_Enter" PointerExited="Card_Exit">
                  <Border.ScaleTransition><Vector3Transition Duration="0:0:0.18"/></Border.ScaleTransition>
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                    <Grid Width="76" Height="76"><Ellipse><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF11998E" Offset="0"/><GradientStop Color="#FF38EF7D" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse><FontIcon Glyph="&#xE896;" FontSize="34" Foreground="White"/></Grid>
                    <TextBlock Text="Receive" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="On this laptop" FontSize="13" Opacity="0.65" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Grid>
              <TextBlock x:Name="HomeInfo" Opacity="0.6" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- SCAN -->
        <Grid x:Name="ScanPage" Visibility="Collapsed">
          <Grid.OpacityTransition><ScalarTransition/></Grid.OpacityTransition>
          <ScrollViewer>
            <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="0,0,0,24" MaxWidth="640">
              <Viewbox MaxWidth="300" MaxHeight="300"><local:Radar x:Name="ScanRadar"/></Viewbox>
              <TextBlock x:Name="ScanTitle" Text="Looking for nearby laptops…" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center"/>
              <TextBlock Text="Open MoveIt on the new laptop and tap Receive" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
              <GridView x:Name="DeviceGrid" IsItemClickEnabled="True" SelectionMode="None" ItemClick="Device_Click" HorizontalAlignment="Center">
                <GridView.ItemTemplate>
                  <DataTemplate x:DataType="local:DeviceItem">
                    <Border Style="{StaticResource GlassCard}" Width="150" Padding="12">
                      <StackPanel Spacing="6">
                        <Grid Width="60" Height="60" HorizontalAlignment="Center">
                          <Ellipse><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF2F80ED" Offset="0"/><GradientStop Color="#FF56CCF2" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse>
                          <FontIcon Glyph="&#xE7F8;" FontSize="26" Foreground="White"/>
                        </Grid>
                        <TextBlock Text="{x:Bind Name}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind Ip}" HorizontalAlignment="Center" Opacity="0.6" FontSize="12"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </GridView.ItemTemplate>
              </GridView>
              <HyperlinkButton Content="Can't find it? Enter IP address manually" Click="Manual_Click" HorizontalAlignment="Center"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- SEND -->
        <Grid x:Name="SendPage" Visibility="Collapsed">
          <Grid.OpacityTransition><ScalarTransition/></Grid.OpacityTransition>
          <ScrollViewer>
            <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" Spacing="16" Margin="0,0,0,24">
              <TextBlock x:Name="SendTitle" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
              <StackPanel x:Name="PickPanel" Spacing="16">
                <Border Style="{StaticResource GlassCard}">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Files and folders" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <ListView x:Name="ItemList" MaxHeight="150" SelectionMode="None"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Add files" Click="AddFiles_Click" CornerRadius="12"/>
                      <Button Content="Add folder" Click="AddFolder_Click" CornerRadius="12"/>
                      <Button Content="Clear" Click="Clear_Click" CornerRadius="12"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Full migration (optional)" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <Grid ColumnSpacing="12">
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                      <CheckBox x:Name="CbDesktop" Content="Desktop" MinWidth="0"/>
                      <CheckBox x:Name="CbDocuments" Content="Documents" Grid.Column="1" MinWidth="0"/>
                      <CheckBox x:Name="CbDownloads" Content="Downloads" Grid.Column="2" MinWidth="0"/>
                      <CheckBox x:Name="CbPictures" Content="Pictures" Grid.Row="1" MinWidth="0"/>
                      <CheckBox x:Name="CbVideos" Content="Videos" Grid.Row="1" Grid.Column="1" MinWidth="0"/>
                      <CheckBox x:Name="CbMusic" Content="Music" Grid.Row="1" Grid.Column="2" MinWidth="0"/>
                    </Grid>
                    <CheckBox x:Name="CbApps" Content="Installed apps list + auto-reinstall script (winget)"/>
                  </StackPanel>
                </Border>
                <Button x:Name="SendBtn" Content="Send" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="46" CornerRadius="16" Click="Send_Click"/>
              </StackPanel>
              <StackPanel x:Name="SendingPanel" Visibility="Collapsed" Spacing="14" HorizontalAlignment="Center" MaxWidth="460">
                <Viewbox MaxWidth="300" MaxHeight="300"><local:Radar x:Name="SendFx"/></Viewbox>
                <TextBlock x:Name="TxPercent" Text="0%" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <ProgressBar x:Name="TxBar" Maximum="100" CornerRadius="4" MinWidth="260"/>
                <TextBlock x:Name="TxStat" HorizontalAlignment="Center" TextAlignment="Center" Opacity="0.8" TextWrapping="Wrap"/>
                <Button x:Name="CancelBtn" Content="Cancel" HorizontalAlignment="Center" CornerRadius="12" Click="Cancel_Click"/>
                <Button x:Name="DoneBtn" Content="Back to home" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" CornerRadius="14" Visibility="Collapsed" Click="Done_Click"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- RECEIVE -->
        <Grid x:Name="RxPage" Visibility="Collapsed">
          <Grid.OpacityTransition><ScalarTransition/></Grid.OpacityTransition>
          <ScrollViewer>
            <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="0,0,0,24" MaxWidth="560">
              <Viewbox MaxWidth="300" MaxHeight="300"><local:Radar x:Name="RxRadar"/></Viewbox>
              <TextBlock Text="Ready to receive" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
              <TextBlock x:Name="RxName" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
              <Border Style="{StaticResource GlassCard}" HorizontalAlignment="Center">
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                  <TextBlock Text="Pairing code" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="CodeText" FontSize="44" FontWeight="Bold" CharacterSpacing="300" IsTextSelectionEnabled="True"/>
                </StackPanel>
              </Border>
              <StackPanel x:Name="RxProgPanel" Visibility="Collapsed" Spacing="6" MinWidth="260">
                <ProgressBar x:Name="RxBar" Maximum="100" CornerRadius="4"/>
                <TextBlock x:Name="RxStat" HorizontalAlignment="Center" TextAlignment="Center" Opacity="0.8"/>
              </StackPanel>
              <TextBlock x:Name="RxStatus" HorizontalAlignment="Center" TextAlignment="Center" Opacity="0.8" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="Saving to" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock x:Name="DestText" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                <HyperlinkButton Content="Change" Click="ChangeDest_Click"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- SETTINGS -->
        <Grid x:Name="SettingsPage" Visibility="Collapsed">
          <Grid.OpacityTransition><ScalarTransition/></Grid.OpacityTransition>
          <ScrollViewer>
            <StackPanel MaxWidth="640" HorizontalAlignment="Stretch" Spacing="16" Margin="0,0,0,24">
              <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>
              <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                  <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                  <RadioButtons x:Name="ThemeRadio" MaxColumns="3" SelectionChanged="Theme_Changed">
                    <x:String>System</x:String><x:String>Light</x:String><x:String>Dark</x:String>
                  </RadioButtons>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="14">
                  <TextBlock Text="General" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                  <TextBox x:Name="NameBox" Header="Device name (shown to other laptops)" LostFocus="Name_LostFocus"/>
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Default save folder" Opacity="0.7" FontSize="12"/>
                      <TextBlock x:Name="FolderText" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Change" Click="SettingsFolder_Click" CornerRadius="12"/>
                  </Grid>
                  <ToggleSwitch x:Name="OpenSwitch" Header="Open the folder when receiving finishes" Toggled="Open_Toggled"/>
                  <Button Content="Reset to defaults" Click="Reset_Click" CornerRadius="12"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="4">
                  <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                  <TextBlock Text="MoveIt 1.1"/>
                  <TextBlock Text="Move files, folders and your app list between Windows laptops over WiFi." Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
