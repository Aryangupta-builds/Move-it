<UserControl x:Class="MoveIt.ParticleFlow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  IsTabStop="False">
  <Grid x:Name="Host" SizeChanged="Host_SizeChanged">
    <!-- all light (aura, ripples, glow) is drawn by Composition visuals attached to this empty grid -->
    <Grid x:Name="FxHost" IsHitTestVisible="False"/>

    <!-- device icon (phone / tablet / laptop) with a circular progress ring around it.
         Hover or tap it to show the transfer details again. -->
    <Grid x:Name="DevIcon" Width="152" Height="152" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0"
          Background="Transparent" RenderTransformOrigin="0.5,0.5"
          PointerEntered="Dev_PointerEntered" PointerExited="Dev_PointerExited" Tapped="Dev_Tapped">
      <Grid.OpacityTransition><ScalarTransition/></Grid.OpacityTransition>
      <Grid.RenderTransform><CompositeTransform x:Name="DevT"/></Grid.RenderTransform>
      <Ellipse Width="124" Height="124" Fill="#14FFFFFF" Stroke="#26FFFFFF" StrokeThickness="1"/>
      <ProgressRing x:Name="DevRing" Width="150" Height="150" IsIndeterminate="False" Minimum="0" Maximum="100" Value="0" IsHitTestVisible="False"
                    Background="#26FFFFFF" Foreground="#FF22D3EE"/>
      <Ellipse Width="96" Height="96" IsHitTestVisible="False">
        <Ellipse.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF2F80ED" Offset="0"/><GradientStop Color="#FF56CCF2" Offset="1"/>
          </LinearGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <FontIcon x:Name="DevGlyph" Glyph="&#xE8EA;" FontSize="42" Foreground="White" IsHitTestVisible="False"/>
    </Grid>

    <!-- small status badge on the lower-right of the icon: connected / complete / error -->
    <Grid x:Name="Badge" Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform><CompositeTransform x:Name="BadgeT" ScaleX="0.4" ScaleY="0.4"/></Grid.RenderTransform>
      <Ellipse Width="44" Height="44" Fill="#33000000"/>
      <Ellipse x:Name="BadgeFill" Width="36" Height="36"/>
      <FontIcon x:Name="BadgeIcon" Glyph="&#xE73E;" FontSize="18" Foreground="White"/>
    </Grid>
  </Grid>
</UserControl>
